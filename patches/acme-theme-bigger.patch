+/* First word of a Rune string, as a fresh byte string, or nil. */
+static char*
+firstword(Rune *r, int n)
+{
+	int nr;
+
+	r = skipbl(r, n, &n);
+	if(n == 0)
+		return nil;
+	findbl(r, n, &nr);
+	n -= nr;
+	if(n == 0)
+		return nil;
+	return runetobyte(r, n);
+}
+
+/* The command's argument word: first word of the remainder after
+ * the command, else first word of the 2-1 click argument. */
+static char*
+cmdarg(Rune *arg, int narg, Text *argt)
+{
+	char *a;
+	Rune *r;
+	int n;
+
+	a = firstword(arg, narg);
+	if(a)
+		return a;
+	getarg(argt, FALSE, TRUE, &r, &n);
+	if(r == nil)
+		return nil;
+	a = firstword(r, n);
+	free(r);
+	return a;
+}
+
+void
+theme(Text *_0, Text *_1, Text *argt, int _2, int _3, Rune *arg, int narg)
+{
+	char *a;
+
+	a = cmdarg(arg, narg, argt);
+	if(a == nil)
+		theme_cycle();
+	else{
+		if(theme_apply(a) != 0)
+			warning(nil, "theme: unknown theme %s\n", a);
+		free(a);
+	}
+}
+
+/* Parse a font name of the form [scale*]prefix.size.font into
+ * its scale, prefix (including the trailing dot), and size.
+ * Returns 0 or -1 when the name carries no size to step.
+ * Plan 9 fonts are fixed-size files, so "one step" is the next
+ * size number with a file behind it; the scale prefix is the
+ * plan9port HiDPI mechanism (N*name) and is preserved.
+ */
+static int
+parsefontsize(char *name, int *scale, char **prefix, int *size)
+{
+	char *p, *dot, *q;
+	int s, z, len;
+
+	*scale = 1;
+	p = name;
+	if('0' <= *p && *p <= '9'){
+		s = 0;
+		while('0' <= *p && *p <= '9'){
+			s = s*10 + (*p-'0');
+			p++;
+		}
+		if(*p == '*' && s > 0){
+			*scale = s;
+			p++;
+		} else
+			p = name;	/* not a scale prefix after all */
+	}
+	len = strlen(p);
+	if(len < 8 || strcmp(p+len-5, ".font") != 0)
+		return -1;
+	/* last dot before ".font" bounds the size */
+	dot = p+len-6;
+	while(dot > p && *dot != '.')
+		dot--;
+	if(*dot != '.')
+		return -1;
+	for(q=dot+1; q < p+len-5; q++)
+		if(*q < '0' || *q > '9')
+			return -1;
+	z = atoi(dot+1);
+	if(z <= 0)
+		return -1;
+	*prefix = emalloc(dot+1-p+1);
+	memmove(*prefix, p, dot+1-p);
+	(*prefix)[dot+1-p] = 0;
+	*size = z;
+	return 0;
+}
+
+/* Open the font at (scale, size) for prefix, via rfget, or nil
+ * when no such font file exists. Probing uses openfont directly
+ * so misses stay silent; rfget would warn on each one.
+ */
+static Reffont*
+tryfont(char *prefix, int scale, int size)
+{
+	char *name, *full;
+	Font *f;
+	Reffont *r;
+
+	name = smprint("%s%d.font", prefix, size);
+	if(scale > 1){
+		full = smprint("%d*%s", scale, name);
+		free(name);
+		name = full;
+	}
+	f = openfont(display, name);
+	if(f == nil){
+		free(name);
+		return nil;
+	}
+	freefont(f);
+	r = rfget(FALSE, FALSE, FALSE, name);
+	free(name);
+	return r;
+}
+
+/* Step the font at cur one rung in dir (>0 bigger, <0 smaller)
+ * along the effective-height ladder: file sizes at the same
+ * scale first, then one scale level when sizes run out.
+ * Returns the new font, or nil with *err 1 (name carries no
+ * size to step) or 2 (ladder end).
+ */
+static Reffont*
+stepfont(Font *cur, int dir, int *err)
+{
+	int scale, size, z;
+	char *prefix;
+	Reffont *r;
+
+	if(parsefontsize(cur->name, &scale, &prefix, &size) != 0){
+		*err = 1;
+		return nil;
+	}
+	if(dir > 0){
+		for(z=size+1; z<=size+64; z++)
+			if((r = tryfont(prefix, scale, z)) != nil){
+				free(prefix);
+				*err = 0;
+				return r;
+			}
+		for(z=1; z<=64; z++){
+			if(z*(scale+1) <= size*scale)
+				continue;
+			if((r = tryfont(prefix, scale+1, z)) != nil){
+				free(prefix);
+				*err = 0;
+				return r;
+			}
+		}
+	}else{
+		for(z=size-1; z>=1; z--)
+			if((r = tryfont(prefix, scale, z)) != nil){
+				free(prefix);
+				*err = 0;
+				return r;
+			}
+		if(scale > 1)
+			for(z=64; z>=1; z--){
+				if(z*(scale-1) >= size*scale)
+					continue;
+				if((r = tryfont(prefix, scale-1, z)) != nil){
+					free(prefix);
+					*err = 0;
+					return r;
+				}
+			}
+	}
+	free(prefix);
+	*err = 2;
+	return nil;
+}
+
+/* Set a window's body font, the way Font does. */
+static void
+applybodyfont(Window *w, Reffont *newfont)
+{
+	Text *t;
+	Dirlist *dp;
+	char *aa;
+	int i;
+
+	t = &w->body;
+	draw(screen, t->w->r, textcols[BACK], nil, ZP);
+	rfclose(t->reffont);
+	t->reffont = newfont;
+	t->fr.font = newfont->f;
+	frinittick(&t->fr);
+	if(t->w->isdir){
+		t->all.min.x++;	/* force recolumnation; disgusting! */
+		for(i=0; i<t->w->ndl; i++){
+			dp = t->w->dlp[i];
+			aa = runetobyte(dp->r, dp->nr);
+			dp->wid = stringwidth(newfont->f, aa);
+			free(aa);
+		}
+	}
+	/* avoid shrinking of window due to quantization */
+	colgrow(t->w->col, t->w, -1);
+}
+
+/* Bigger [n] / Smaller [n]: step the window's body font size
+ * up or down n sizes (default 1), like wily. Only the body
+ * font moves; tags keep the global font, as Font does.
+ */
+static void
+fontstep(Text *et, Text *argt, Rune *arg, int narg, int dir, char *name)
+{
+	Window *w;
+	Reffont *nf;
+	char *a;
+	int steps, i, err;
+
+	if(et==nil || et->w==nil)
+		return;
+	w = et->w;
+	a = cmdarg(arg, narg, argt);
+	steps = 1;
+	if(a){
+		steps = atoi(a);
+		if(steps <= 0)
+			steps = 1;
+		if(steps > 16)
+			steps = 16;
+		free(a);
+	}
+	for(i=0; i<steps; i++){
+		nf = stepfont(w->body.fr.font, dir, &err);
+		if(nf == nil){
+			if(err == 1)
+				warning(nil, "%s: this font cannot be resized\n", name);
+			else
+				warning(nil, "%s: no larger/smaller font available\n", name);
+			return;
+		}
+		applybodyfont(w, nf);
+	}
+}
