+/*
+ * Themes: named foreground/background pairs, ported from wily.
+ * A theme sets tag and body colors alike (wily's single-pair
+ * model): BACK is the background, TEXT/HTEXT the foreground,
+ * HIGH a mix of the two for selections, BORD the foreground.
+ * Until a theme is chosen, acme keeps its classic colors
+ * (curtheme < 0); the dump records a theme only once chosen,
+ * so an untouched session round-trips to classic colors.
+ */
+
+typedef struct Theme Theme;
+struct Theme
+{
+	char	*name;
+	char	*fg;
+	char	*bg;
+};
+
+static Theme themes[] =
+{
+	/* default: black on white */
+	{ "default",		"#000000", "#ffffff" },
+	/* Tokyo Night (night variant) */
+	{ "tokyo",		"#c0caf5", "#1a1b26" },
+	/* Tokyo Night Day (light variant) */
+	{ "tokyo-light",	"#3760bf", "#e1e2e7" },
+	/* Catppuccin Mocha */
+	{ "catppuccin",		"#cdd6f4", "#1e1e2e" },
+	/* Catppuccin Latte (light variant) */
+	{ "catppuccin-light",	"#4c4f69", "#eff1f5" },
+	/* Solarized (dark): base0 on base03 */
+	{ "solarized",		"#839496", "#002b36" },
+	/* Solarized (light): base00 on base3 */
+	{ "solarized-light",	"#657b83", "#fdf6e3" },
+	/* Nord (dark): nord4 on nord0 */
+	{ "nord",		"#d8dee9", "#2e3440" },
+	/* Nord Light: nord0 on nord6. Nord ships no official
+	 * light variant; this is the community inversion, the
+	 * same pair other nord-light ports use.
+	 */
+	{ "nord-light",		"#2e3440", "#eceff4" },
+	/* Rosé Pine (main): text on base */
+	{ "rose-pine",		"#e0def4", "#191724" },
+	/* Rosé Pine Dawn (light): text on base */
+	{ "rose-pine-dawn",	"#575279", "#faf4ed" },
+};
+static int nthemes = sizeof(themes)/sizeof(themes[0]);
+static int curtheme = -1;
+
+char*
+themename(void)
+{
+	if(curtheme < 0)
+		return nil;
+	return themes[curtheme].name;
+}
+
+/* Find a theme by name, accepting a couple of obvious aliases. */
+static int
+theme_lookup(char *name)
+{
+	int i;
+
+	if(name == nil)
+		return -1;
+	for(i=0; i<nthemes; i++)
+		if(strcmp(name, themes[i].name) == 0)
+			return i;
+	/* aliases, same as wily */
+	if(strcmp(name, "tokyonight") == 0)
+		return 1;
+	if(strcmp(name, "tokyonight-day") == 0 || strcmp(name, "day") == 0)
+		return 2;
+	if(strcmp(name, "mocha") == 0 || strcmp(name, "catppuccin-mocha") == 0)
+		return 3;
+	if(strcmp(name, "latte") == 0 || strcmp(name, "catppuccin-latte") == 0)
+		return 4;
+	if(strcmp(name, "solarized-dark") == 0)
+		return 5;
+	if(strcmp(name, "nord-dark") == 0)
+		return 7;
+	if(strcmp(name, "rose-pine-main") == 0)
+		return 9;
+	if(strcmp(name, "rose-pine-light") == 0 || strcmp(name, "dawn") == 0)
+		return 10;
+	return -1;
+}
+
+/* "#rrggbb" to a 32-bit RGBA color; 0 on malformed input. */
+static ulong
+hexcolor(char *s)
+{
+	int i, v;
+	ulong c;
+
+	if(s == nil || s[0] != '#' || strlen(s) != 7)
+		return 0;
+	c = 0;
+	for(i=1; i<7; i++){
+		if('0' <= s[i] && s[i] <= '9')
+			v = s[i]-'0';
+		else if('a' <= s[i] && s[i] <= 'f')
+			v = s[i]-'a'+10;
+		else if('A' <= s[i] && s[i] <= 'F')
+			v = s[i]-'A'+10;
+		else
+			return 0;
+		c = (c<<4) | v;
+	}
+	return (c<<8) | 0xFF;
+}
+
+static Image*
+mkcolor(ulong c)
+{
+	return allocimage(display, Rect(0,0,1,1), screen->chan, 1, c);
+}
+
+static ulong
+blendcolor(ulong a, ulong b, int num, int den)
+{
+	int r, g, bl;
+
+	r = (int)(((a>>24)&0xFF)*(den-num) + ((b>>24)&0xFF)*num)/den;
+	g = (int)(((a>>16)&0xFF)*(den-num) + ((b>>16)&0xFF)*num)/den;
+	bl = (int)(((a>>8)&0xFF)*(den-num) + ((b>>8)&0xFF)*num)/den;
+	return ((ulong)r<<24) | ((ulong)g<<16) | ((ulong)bl<<8) | 0xFF;
+}
+
+/* One color level: BACK as given, text colors from fg, and the
+ * selection highlight as fg mixed over BACK (as classic does). */
+static int
+mklevel(Image **cols, ulong back, ulong fg)
+{
+	int i;
+
+	cols[BACK] = mkcolor(back);
+	cols[TEXT] = mkcolor(fg);
+	cols[HTEXT] = mkcolor(fg);
+	cols[HIGH] = allocimagemix(display, fg, back);
+	cols[BORD] = mkcolor(fg);
+	for(i=0; i<NCOL; i++)
+		if(cols[i] == nil){
+			for(i=0; i<NCOL; i++)
+				if(cols[i])
+					freeimage(cols[i]);
+			return -1;
+		}
+	return 0;
+}
+
+static void
+freelevel(Image **cols)
+{
+	int i;
+
+	for(i=0; i<NCOL; i++)
+		if(cols[i] != display->black && cols[i] != display->white)
+			freeimage(cols[i]);
+}
+
+/* Free old levels, each distinct image once. The tag levels
+ * alias the same images until the first theme (iconinit copies
+ * tagcols into them), so freeing each array blindly would
+ * double-free the classic colors. */
+static void
+freelevels(Image **a1, Image **a2, Image **a3, Image **a4)
+{
+	Image **arrs[4];
+	Image *freed[4*NCOL];
+	int nf = 0, i, j, k;
+
+	arrs[0] = a1;
+	arrs[1] = a2;
+	arrs[2] = a3;
+	arrs[3] = a4;
+	for(k=0; k<4; k++)
+		for(i=0; i<NCOL; i++){
+			Image *p = arrs[k][i];
+			if(p == nil || p == display->black || p == display->white)
+				continue;
+			for(j=0; j<nf; j++)
+				if(freed[j] == p)
+					break;
+			if(j < nf)
+				continue;
+			freed[nf++] = p;
+			freeimage(p);
+		}
+}
+
+static void
+repaint_text(Text *t, Image **cols)
+{
+	memmove(t->fr.cols, cols, sizeof(t->fr.cols));
+	/* fr.r is the text area; odx equal to the width skips
+	 * directory recolumnation, and org (scroll) is untouched */
+	textredraw(t, t->fr.r, t->fr.font, t->fr.b, Dx(t->all));
+}
+
+static void
+repaint_all(void)
+{
+	int i, j;
+	Column *c;
+	Window *w;
+
+	repaint_text(&row.tag, rowtagcols);
+	for(i=0; i<row.ncol; i++){
+		c = row.col[i];
+		repaint_text(&c->tag, coltagcols);
+		for(j=0; j<c->nw; j++){
+			w = c->w[j];
+			repaint_text(&w->tag, tagcols);
+			repaint_text(&w->body, textcols);
+			/* scrollbar caches its thumb; force a redraw */
+			w->body.lastsr = nullrect;
+			textscrdraw(&w->body);
+			windrawbutton(w);
+		}
+	}
+}
+
+int
+theme_apply(char *name)
+{
+	int idx, i;
+	ulong fg, bg;
+	ulong wback, cback, rback;
+	Image *newtag[NCOL], *newcoltag[NCOL], *newrowtag[NCOL], *newtext[NCOL];
+	Image *oldtag[NCOL], *oldcoltag[NCOL], *oldrowtag[NCOL], *oldtext[NCOL];
+
+	idx = theme_lookup(name);
+	if(idx < 0)
+		return -1;
+	fg = hexcolor(themes[idx].fg);
+	bg = hexcolor(themes[idx].bg);
+	if(fg == 0 || bg == 0)
+		return -1;
+	/* Tag levels lift from the body toward the text color:
+	 * window tags a little, column tags more, row tag most. */
+	wback = blendcolor(bg, fg, 1, 8);
+	cback = blendcolor(bg, fg, 1, 4);
+	rback = blendcolor(bg, fg, 1, 2);
+	/* allocate every new image before touching the old ones */
+	for(i=0; i<NCOL; i++){
+		newtag[i] = nil;
+		newcoltag[i] = nil;
+		newrowtag[i] = nil;
+		newtext[i] = nil;
+	}
+	if(mklevel(newtext, bg, fg) < 0)
+		return -1;
+	if(mklevel(newtag, wback, fg) < 0){
+		freelevel(newtext);
+		return -1;
+	}
+	if(mklevel(newcoltag, cback, fg) < 0){
+		freelevel(newtext);
+		freelevel(newtag);
+		return -1;
+	}
+	if(mklevel(newrowtag, rback, fg) < 0){
+		freelevel(newtext);
+		freelevel(newtag);
+		freelevel(newcoltag);
+		return -1;
+	}
+	/* commit: globals, then buttons, then repaint, then free old */
+	memmove(oldtag, tagcols, sizeof(oldtag));
+	memmove(oldcoltag, coltagcols, sizeof(oldcoltag));
+	memmove(oldrowtag, rowtagcols, sizeof(oldrowtag));
+	memmove(oldtext, textcols, sizeof(oldtext));
+	memmove(tagcols, newtag, sizeof(tagcols));
+	memmove(coltagcols, newcoltag, sizeof(coltagcols));
+	memmove(rowtagcols, newrowtag, sizeof(rowtagcols));
+	memmove(textcols, newtext, sizeof(textcols));
+	if(button){
+		freeimage(button);
+		freeimage(modbutton);
+		freeimage(colbutton);
+		button = modbutton = colbutton = nil;
+	}
+	iconinit();
+	repaint_all();
+	/* TEXT/HTEXT are display->black in the classic colors: a
+	 * shared display image that must never be freed. Only free
+	 * images a theme (or iconinit) allocated, each one once. */
+	freelevels(oldtag, oldcoltag, oldrowtag, oldtext);
+	curtheme = idx;
+	return 0;
+}
+
+void
+theme_cycle(void)
+{
+	if(curtheme < 0)
+		theme_apply(themes[0].name);
+	else
+		theme_apply(themes[(curtheme+1)%nthemes].name);
+}
